---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bio from "../components/About/Bio/Bio.astro";
import WorkingTogether from "../components/About/WorkingTogether.astro";
import EyebrowLabel from "../components/shared/EyebrowLabel.astro";
---

<BaseLayout
  title="About — David P Larsen"
  description="About David Larsen, full-stack engineer."
>
  <div class="about-stack">
    <EyebrowLabel as="h2" class="about-eyebrow" text="About" />

    <Bio />

    <hr />

    <WorkingTogether />
  </div>
</BaseLayout>

<style>
  .about-eyebrow {
    margin-top: 0;
  }

  hr {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }
</style>
