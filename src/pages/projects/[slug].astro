---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectList from "../../components/Projects/ProjectList.astro";
import DetailDrawer from "../../components/shared/DetailDrawer.astro";
import EyebrowLabel from "../../components/shared/EyebrowLabel.astro";
import Headline from "../../components/shared/Headline.astro";
import ProjectLinks from "../../components/Projects/ProjectLinks/ProjectLinks.astro";
import TechStack from "../../components/Projects/TechStack/TechStack.astro";
import { demoMap } from "../../components/Projects/Demos/demoMap";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, process, challenges, tech, links, id } =
  project.data;
const Demo = demoMap[id];
---

<BaseLayout title={`${title} — David P Larsen`} description={description}>
  <ProjectList />

  <DetailDrawer
    closeHref="/projects"
    closeLabel="Close project detail"
    maxWidth="36rem"
  >
    <EyebrowLabel as="h2" text={title.toUpperCase()} />

    <TechStack tech={tech} />

    <hr class="title-divider" />

    <div class="body">
      <Content />
    </div>

    <ProjectLinks links={links} />

    <div class="detail-grid">
      <div class="panel">
        <section>
          <Headline as="h3" size="md">Process</Headline>
          <p>{process}</p>
        </section>

        <section>
          <Headline as="h3" size="md">Challenges &amp; Solutions</Headline>
          <p>{challenges}</p>
        </section>
      </div>

      <div class="stage">
        {Demo ? <Demo /> : null}
      </div>
    </div>
  </DetailDrawer>
</BaseLayout>

<style>
  .title-divider {
    border: none;
    border-top: 2px solid var(--color-accent);
    margin: 1rem 0 1rem;
  }

  .description {
    max-width: 60ch;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 1.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .panel section {
    margin-bottom: 1.5rem;
  }

  .body {
    max-width: 60ch;
  }
</style>
