---
import BaseLayout from "../layouts/BaseLayout.astro";
import EyebrowLabel from "../components/shared/EyebrowLabel.astro";
import LedgerEntry from "../components/AuditLog/LedgerEntry.astro";
import { getSortedAuditEntries } from "../content/audit-log-utils";

const entries = await getSortedAuditEntries();
---

<BaseLayout
  title="Accomplishment Changelog — David P Larsen"
  description="Full commit-style accomplishment changelog for David Larsen's portfolio and career."
>
  <EyebrowLabel as="h2" text="ACCOMPLISHMENT CHANGELOG" />
  {entries.map((entry) => <LedgerEntry entry={entry} />)}
</BaseLayout>
