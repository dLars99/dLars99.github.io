---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkList from "../../components/Work/WorkList.astro";
import DetailDrawer from "../../components/shared/DetailDrawer.astro";
import EyebrowLabel from "../../components/shared/EyebrowLabel.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

export async function getStaticPaths() {
  const roles = await getCollection("work");
  return roles.map((work) => ({
    params: { slug: work.data.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { company, companyDescription, roles, location, highlights } = work.data;
const dateFormat = "MMMM y";
const formatDates = (startDate: Date, endDate?: Date) =>
  `${format(startDate, dateFormat)} – ${endDate ? format(endDate, dateFormat) : "Present"}`;
const titles = roles.map(({ title }) => title).join(", ");
---

<BaseLayout
  title={`${company} — David P Larsen`}
  description={`${titles} at ${company}.`}
>
  <WorkList />

  <DetailDrawer closeHref="/work" closeLabel="Close role detail">
    <EyebrowLabel as="h2" text={company.toUpperCase()} />
    <ul class="roles" role="list">
      {
        roles.map(({ title, startDate, endDate }) => (
          <li class="role">
            <span class="role-title">{title}</span>
            <span class="role-dates">{formatDates(startDate, endDate)}</span>
          </li>
        ))
      }
    </ul>
    <p class="location">{location}</p>
    {
      companyDescription && (
        <p class="company-description">{companyDescription}</p>
      )
    }
    <ul class="highlights">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
  </DetailDrawer>
</BaseLayout>

<style>
  .roles {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .role {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-left: 1.75rem;
    padding-bottom: 1.25rem;
  }

  /* timeline dot */
  .role::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.625rem;
    height: 0.625rem;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-canvas);
  }

  /* connector to the next role */
  .role:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(0.3125rem - 1px);
    top: calc(0.45em + 0.875rem);
    bottom: calc(0.25rem - 0.45em);
    width: 2px;
    background: var(--color-accent);
  }

  .role:first-child::before {
    background: var(--color-accent);
  }

  .role-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .role:first-child .role-title {
    color: var(--color-text-primary);
  }

  .role-dates,
  .location {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
  }

  .location {
    margin: 0.25rem 0 1.5rem 1.75rem;
  }

  .company-description {
    margin: 0 0 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-text-secondary);
    font-style: italic;
    line-height: 1.6;
  }

  .highlights {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .highlights li {
    margin-bottom: 0.75rem;
  }

  .highlights li::marker {
    color: var(--color-accent);
  }
</style>
