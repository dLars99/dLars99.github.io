---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkList from "../../components/Work/WorkList.astro";
import DetailDrawer from "../../components/shared/DetailDrawer.astro";
import EyebrowLabel from "../../components/shared/EyebrowLabel.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

export async function getStaticPaths() {
  const roles = await getCollection("work");
  return roles.map((work) => ({
    params: { slug: work.data.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { company, roles, location, highlights } = work.data;
const dateFormat = "MMMM y";
const formatDates = (startDate: Date, endDate?: Date) =>
  `${format(startDate, dateFormat)} – ${endDate ? format(endDate, dateFormat) : "Present"}`;
const titles = roles.map(({ title }) => title).join(", ");
---

<BaseLayout title={`${company} — David P Larsen`} description={`${titles} at ${company}.`}>
  <WorkList />

  <DetailDrawer closeHref="/work" closeLabel="Close role detail">
    <EyebrowLabel as="h2" text={company.toUpperCase()} />
    <ul class="roles" role="list">
      {
        roles.map(({ title, startDate, endDate }) => (
          <li class="meta">
            <span class="role-title">{title}</span> ·{" "}
            {formatDates(startDate, endDate)}
          </li>
        ))
      }
    </ul>
    <p class="meta location">{location}</p>
    <ul class="highlights">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
  </DetailDrawer>
</BaseLayout>

<style>
  .roles {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .meta {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .role-title {
    font-weight: 600;
  }

  .location {
    margin: 0.25rem 0 1.5rem;
  }

  .highlights {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .highlights li {
    margin-bottom: 0.75rem;
  }
</style>
