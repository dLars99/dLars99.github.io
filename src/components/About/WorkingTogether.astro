---
import EyebrowLabel from "../shared/EyebrowLabel.astro";

const traits = [
  {
    title: "Independent & Self-Directed",
    description:
      "Give me a problem space and a goal, and I'll figure out the execution. I don't need hand-holding or granular task management to ship clean work.",
  },
  {
    title: "Design-Aware",
    description:
      "I speak fluent layout, spacing, and typography. I can jump into Figma, refine micro-interactions on the fly, or build straight in the browser when mockups don't cover every edge case.",
  },
  {
    title: "Pragmatic Communication",
    description:
      "Clear, direct, and asynchronous-friendly. I write thorough PR descriptions, document system choices, and keep team friction as low as possible.",
  },
];
---

<EyebrowLabel as="h2" text="WORKING TOGETHER" />
<ul>
  {
    traits.map((trait) => (
      <li>
        <h3>{trait.title}</h3>
        <p>{trait.description}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  li {
    position: relative;
    padding: 0 0 1.25rem 1.75rem;
  }

  li:last-child {
    padding-bottom: 0;
  }

  /* Ringed dot marker */
  li::before {
    content: "";
    position: absolute;
    top: 0.3rem;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  /* Connector line between markers */
  li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 1.15rem;
    bottom: 0.15rem;
    left: calc(0.25rem - 0.5px);
    width: 1px;
    background: var(--color-border);
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  p {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
