---
import { Image } from "astro:assets";
import ActionLink from "../shared/ActionLink.astro";
import GitHubImage from "../../images/icons/github.png";
import LinkedInImage from "../../images/icons/linkedin.png";

const links = [
  {
    name: "LinkedIn",
    icon: LinkedInImage,
    href: "https://www.linkedin.com/in/david-larsen-minneapolis",
    description: "Best for direct messages, professional inquiries, and current roles.",
    action: "VISIT PROFILE",
  },
  {
    name: "GitHub",
    icon: GitHubImage,
    href: "https://www.github.com/dlars99",
    description: "Open-source projects, weekend utility builds, and active repositories.",
    action: "EXPLORE CODE",
  },
];
---

<ul class="links" role="list">
  {
    links.map((link) => (
      <li class="link">
        <Image class="icon" src={link.icon} alt="" height={44} />
        <h2 class="name">{link.name}</h2>
        <p class="description">{link.description}</p>
        <ActionLink
          class="action"
          href={link.href}
          label={link.action}
          target="_blank"
          rel="noopener noreferrer"
        />
      </li>
    ))
  }
</ul>

<style>
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 48rem;
  }

  .link {
    display: grid;
    grid-template-columns: 52px 1fr;
    grid-template-areas:
      "icon name"
      "icon description"
      "icon action";
    grid-template-rows: auto auto 1fr;
    column-gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .link:first-child {
    padding-top: 0;
  }

  .link:last-child {
    border-bottom: none;
  }

  .icon {
    grid-area: icon;
    width: 52px;
    object-fit: contain;
    object-position: left top;
  }

  .name {
    grid-area: name;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .description {
    grid-area: description;
    color: var(--color-text-primary);
    line-height: 1.55;
    margin: 0.375rem 0 1rem;
  }

  .action {
    grid-area: action;
    justify-self: start;
  }

  @media (max-width: 768px) {
    .link {
      grid-template-areas:
        "icon name"
        "description description"
        "action action";
    }

    .name {
      align-self: center;
    }

    .description {
      margin-top: 0.75rem;
    }
  }
</style>
