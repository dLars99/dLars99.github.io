---
import { Image } from "astro:assets";
import GitHubImage from "../../images/icons/github.png";
import LinkedInImage from "../../images/icons/linkedin.png";
---

<div class="links">
  <a class="link" href="https://www.github.com/dlars99">
    <Image src={GitHubImage} alt="" width={32} height={32} />
    <span>GitHub</span>
  </a>

  <a class="link" href="https://www.linkedin.com/in/david-larsen-minneapolis">
    <Image src={LinkedInImage} alt="" width={32} height={32} />
    <span>LinkedIn</span>
  </a>
</div>

<style>
  .links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 20rem;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: 600;
  }
</style>
