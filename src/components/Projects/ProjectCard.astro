---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Headline from "../shared/Headline.astro";
import DetailsLink from "../shared/DetailsLink.astro";
import { format, parseISO } from "date-fns";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const {
  title,
  description,
  id,
  image,
  imageAlt,
  imageOrientation,
  initialCompletionDate,
  lastUpdatedDate,
} = project.data;
const isVertical = imageOrientation === "vertical";
const isPortrait = image.height > image.width;
const formatDate = (date: string) => format(parseISO(date), "MMM d, y");
---

<article class:list={["card", { vertical: isVertical, portrait: isPortrait }]}>
  <div class="layout">
    <div class="body">
      <Headline>{title}</Headline>

      <p class="meta">
        Launched <time datetime={initialCompletionDate}
          >{formatDate(initialCompletionDate)}</time
        >
        {" · "}Last updated <time datetime={lastUpdatedDate}
          >{formatDate(lastUpdatedDate)}</time
        >
      </p>

      <p>{description}</p>
    </div>

    <DetailsLink class="details-link" href={`/projects/${id}`} />

    <Image
      class="thumbnail"
      src={image}
      alt={imageAlt}
      widths={isVertical ? [280, 560] : [400, 800]}
      sizes={isVertical
        ? "(min-width: 769px) 100px, 280px"
        : "(min-width: 769px) 300px, 100vw"}
    />
  </div>
</article>

<style>
  .card {
    container-type: inline-size;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .card:last-of-type {
    border-bottom: none;
  }

  p {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
  }

  .layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .body p:last-child {
    margin-bottom: 0;
  }

  .meta {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .thumbnail {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    border-radius: 0.75rem;
  }

  .vertical .thumbnail {
    max-width: 280px;
  }

  .details-link {
    align-self: flex-start;
    justify-self: start;
  }

  @container (min-width: 500px) {
    .layout {
      display: grid;
      grid-template-columns: clamp(180px, 35%, 300px) 1fr;
      align-items: center;
      gap: 1rem 1.5rem;
    }

    .thumbnail {
      grid-column: 1;
      grid-row: 1;
    }

    .body {
      grid-column: 2;
      grid-row: 1;
    }

    .details-link {
      grid-column: 2;
      grid-row: 2;
    }

    .vertical .thumbnail {
      max-width: 100px;
      justify-self: center;
    }

    .portrait .thumbnail {
      grid-row: 1 / span 2;
    }
  }
</style>
