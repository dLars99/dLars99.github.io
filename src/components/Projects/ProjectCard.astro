---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Headline from "../shared/Headline.astro";
import { format, parseISO } from "date-fns";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const {
  title,
  description,
  id,
  image,
  imageAlt,
  initialCompletionDate,
  lastUpdatedDate,
} = project.data;
const formatDate = (date: string) => format(parseISO(date), "MMM d, y");
---

<article class="card">
  <Headline>{title}</Headline>

  <p class="meta">
    Launched <time datetime={initialCompletionDate}
      >{formatDate(initialCompletionDate)}</time
    >
    {" · "}Last updated <time datetime={lastUpdatedDate}
      >{formatDate(lastUpdatedDate)}</time
    >
  </p>

  <p>{description}</p>

  <div class="media">
    <a class="details-link" href={`/projects/${id}`}>[ VIEW DETAILS ]</a>
    <Image
      class="thumbnail"
      src={image}
      alt={imageAlt}
      widths={[400, 800]}
      sizes="(min-width: 769px) 800px, 100vw"
    />
  </div>
</article>

<style>
  .card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  p {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
  }

  .meta {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .media {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .thumbnail {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .details-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 300;
    color: var(--color-canvas);
    background: var(--color-fill-primary);
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.25);
  }

  .details-link:hover,
  .details-link:focus-visible {
    filter: brightness(1.1);
  }

  @media (min-width: 769px) {
    .media {
      position: relative;
      display: block;
    }

    .details-link {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1;
    }
  }
</style>
