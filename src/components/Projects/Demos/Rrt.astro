---
import { Image } from "astro:assets";
import RrtImage from "../../../images/rrt/rrt.png";
---

<div>
  <figure class="figure">
    <a href="react-routing-tabs">
      <Image
        alt="A recursive screenshot showing the 'This Website' card in the 'Projects' section"
        src={RrtImage}
        width={500}
      />
      <figcaption>Click to go to the working demo</figcaption>
    </a>
  </figure>
</div>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
  }

  .figure a {
    color: var(--color-accent);
    cursor: pointer;
  }

  .figure a:hover {
    text-decoration: underline;
  }

  figcaption {
    margin-top: 0.25rem;
  }
</style>
