---
import ProjectCard from "./ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.lastUpdatedDate < b.data.lastUpdatedDate ? 1 : -1,
);
---

<p class="intro">
  A collection of small personal tools and weekend builds. I use these to
  scratch a specific itch or test out an idea quickly, prioritizing functional
  utility over an over-engineered setup. You'll find a couple of exceptions
  here, like this portfolio, where the build is more deliberate and fully
  realized.
</p>

{projects.map((project) => <ProjectCard project={project} />)}

<style>
  .intro {
    max-width: 60ch;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }
</style>
