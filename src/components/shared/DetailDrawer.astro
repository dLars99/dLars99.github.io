---
interface Props {
  closeHref: string;
  closeLabel?: string;
  maxWidth?: string;
}

const { closeHref, closeLabel = "Close", maxWidth = "48rem" } = Astro.props;
---

<a class="drawer-backdrop" href={closeHref} aria-label={closeLabel}></a>
<div class="drawer-panel" role="dialog" aria-modal="true" style={`--drawer-max-width: ${maxWidth}`}>
  <a class="drawer-close" href={closeHref} aria-label={closeLabel}>✕</a>
  <div class="drawer-content">
    <slot />
  </div>
</div>

<style>
  .drawer-backdrop {
    display: none;
  }

  .drawer-panel {
    position: fixed;
    inset: 0;
    z-index: 35;
    overflow-y: auto;
    padding: 2.5rem;
    background: var(--color-canvas);
  }

  @media (min-width: 769px) {
    .drawer-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 30;
      background: rgba(17, 17, 17, 0.4);
      animation: backdrop-fade-in var(--motion-fast) ease-out;
    }

    .drawer-panel {
      left: auto;
      width: 100%;
      max-width: var(--drawer-max-width);
      border-radius: 12px 0 0 12px;
      animation: drawer-slide-in-right var(--motion-slow) cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }

  @keyframes drawer-slide-in-right {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .drawer-close {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: -0.5rem -0.5rem -1.5rem auto; /* no flow height, so content starts at the padding */
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-canvas);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .drawer-content {
    container-type: inline-size;
  }

  .drawer-content > :global(:first-child) {
    margin-top: 0;
  }

  .drawer-content :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>

<script define:vars={{ closeHref }}>
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      window.location.href = closeHref;
    }
  });
</script>
