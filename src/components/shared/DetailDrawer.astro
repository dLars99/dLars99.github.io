---
interface Props {
  closeHref: string;
  closeLabel?: string;
}

const { closeHref, closeLabel = "Close" } = Astro.props;
---

<a class="drawer-backdrop" href={closeHref} aria-label={closeLabel}></a>
<div class="drawer-panel" role="dialog" aria-modal="true">
  <a class="drawer-close" href={closeHref} aria-label={closeLabel}>✕</a>
  <div class="drawer-content">
    <slot />
  </div>
</div>

<style>
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: rgba(17, 17, 17, 0.4);
    animation: backdrop-fade-in var(--motion-fast) ease-out;
  }

  .drawer-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 35;
    width: 100%;
    max-width: 48rem;
    overflow-y: auto;
    padding: 2.5rem;
    border-radius: 12px 0 0 12px;
    background: var(--color-canvas);
    animation: drawer-slide-in-right var(--motion-slow) cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes drawer-slide-in-right {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .drawer-close {
    position: sticky;
    top: 0;
    float: right;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: -0.5rem -0.5rem 0 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-canvas);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .drawer-content {
    clear: both;
    container-type: inline-size;
  }
</style>

<script define:vars={{ closeHref }}>
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      window.location.href = closeHref;
    }
  });
</script>
