---
interface Props {
  text: string;
  as?: "span" | "h2" | "h3";
  variant?: "primary" | "secondary";
  class?: string;
}

const {
  text,
  as: Tag = "span",
  variant = "primary",
  class: className,
  ...rest
} = Astro.props;
const labelText = variant === "primary" ? `[ ${text} ]` : text;
---

<Tag {...rest} class:list={["eyebrow", className]}>{labelText}</Tag>

<style>
  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: 0;
    color: var(--color-accent);
    text-transform: uppercase;
  }
</style>
