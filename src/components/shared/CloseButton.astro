---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  href: string;
  label?: string;
};

const { href, label = "Close", ...rest } = Astro.props;
---

<a class="close-button" href={href} aria-label={label} {...rest}>✕</a>

<style>
  .close-button {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: -0.5rem -0.5rem -1.5rem auto; /* no flow height, so content starts at the padding */
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-primary);
    text-decoration: none;
    transition:
      background-color var(--motion-fast) ease-out,
      color var(--motion-fast) ease-out;
  }

  .close-button:hover {
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    color: var(--color-accent);
  }
</style>
