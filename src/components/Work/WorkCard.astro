---
import type { CollectionEntry } from "astro:content";
import { format } from "date-fns";
import DetailsLink from "../shared/DetailsLink.astro";

interface Props {
  work: CollectionEntry<"work">;
}

const { work } = Astro.props;
const { id, company, roles, location } = work.data;
const dateFormat = "MMMM y";
const formatDates = (startDate: Date, endDate?: Date) =>
  `${format(startDate, dateFormat)} – ${endDate ? format(endDate, dateFormat) : "Present"}`;
---

<article class="card">
  <h2>{company}</h2>
  <ul class="roles" role="list">
    {
      roles.map(({ title, startDate, endDate }) => (
        <li class="meta">
          <span class="role-title">{title}</span> ·{" "}
          {formatDates(startDate, endDate)}
        </li>
      ))
    }
  </ul>
  <p class="meta location">{location}</p>
  <DetailsLink href={`/work/${id}`}>[ VIEW DETAILS ]</DetailsLink>
</article>

<style>
  .card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .card:last-of-type {
    border-bottom: none;
  }

  h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
    color: var(--color-text-primary);
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .meta {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .role-title {
    font-weight: 600;
  }

  .location {
    margin: 0.25rem 0 0.75rem;
    font-size: 0.8125rem;
  }
</style>
