---
import type { CollectionEntry } from "astro:content";
import { format } from "date-fns";
import DetailsLink from "../shared/DetailsLink.astro";

interface Props {
  work: CollectionEntry<"work">;
}

const { work } = Astro.props;
const { id, company, title, location, startDate, endDate } = work.data;
const dateFormat = "MMMM y";
const dates = `${format(startDate, dateFormat)} – ${endDate ? format(endDate, dateFormat) : "Present"}`;
---

<article class="card">
  <h2>{company}</h2>
  <p class="meta">{title} · {dates} · {location}</p>
  <DetailsLink href={`/work/${id}`}>[ VIEW DETAILS ]</DetailsLink>
</article>

<style>
  .card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .card:last-of-type {
    border-bottom: none;
  }

  h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
    color: var(--color-text-primary);
  }

  .meta {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
</style>
